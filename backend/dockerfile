FROM python:3.12-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:0.11.21 /uv /uvx /bin/

WORKDIR /code
RUN useradd -m -u 1000 app && chown app:app /code /home/app
USER app 

# deps first, so source edits don't reinstall the world
COPY pyproject.toml uv.lock /code/
RUN uv sync --frozen --no-dev --no-install-project

# bake the spatial extension into the image cache
RUN uv run python -c "import duckdb; duckdb.connect().execute('INSTALL spatial')"

# TODO: remove app_utils or at least greatly clean it from this point.
COPY --chown=app:app ./api /code/api
COPY --chown=app:app ./query /code/query
COPY --chown=app:app ./logger /code/logger
COPY --chown=app:app ./app_utils /code/app_utils



USER app

ENV DATA_DIR=/data
ENV PYTHONPATH=/code 

EXPOSE 6767

CMD ["uv", "run", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "6767"]