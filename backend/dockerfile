FROM python:3.13-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:0.11.21 /uv /uvx /bin/

WORKDIR /code
RUN useradd -m -u 1000 app && chown app:app /code /home/app
USER app 

# deps first, so source edits don't reinstall the world
COPY pyproject.toml uv.lock /code/
RUN uv sync --frozen --no-dev --no-install-project

# bake the spatial extension into the image cache
RUN /code/.venv/bin/python -c "import duckdb; duckdb.connect().execute('INSTALL spatial')"

COPY --chown=app:app ./api /code/api
COPY --chown=app:app ./query /code/query
COPY --chown=app:app ./logger /code/logger
COPY --chown=app:app ./data_tools /code/data_tools
COPY --chown=app:app ./mcp_server /code/mcp_server



USER app

ENV DATA_DIR=/data
ENV PYTHONPATH=/code 

EXPOSE 6767

# Run the already-installed runtime environment without syncing dev dependencies
# or resolving packages again when the container starts.
CMD ["/code/.venv/bin/uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "6767"]
