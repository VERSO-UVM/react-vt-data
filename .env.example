# Copy this file to `.env` in the project root and fill in the values.
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit real keys. The justfile loads this file
# automatically (`set dotenv-filename := ".env"`), so any recipe that needs a
# variable will pick it up.

# --- Required for the ETL data-collection step -------------------------------

# Census Bureau API key, used by the ACS-5 scrapers in backend/data_collection/.
# Request one (free, instant) at https://api.census.gov/data/key_signup.html
#
# Needed by: `just get-data`, `just run-etl`
# Without it the Census API caps you at ~500 requests/day and a full multi-year
# run will silently come back mostly empty.
CENSUS_API_KEY=


## podman flags to run on the vm. Uncomment this line on the vm. 
# PODMAN_FLAGS=--userns=keep-id:uid=1000,gid=1000 

# --- Optional overrides ------------------------------------------------------

# Where the DuckLake catalog, its parquet files, and warehouse.duckdb live.
# The justfile defaults to backend/Data. Use an absolute path when overriding.
# API containers mount this directory read-only at /data internally.
# DATA_DIR=

# --- MCP (see docs/mcp.md) ---------------------------------------------------

# Opt in to /api/mcp on the existing API server/container. Disabled by default.
# The standalone `just mcp` server does not require this flag.
# MCP_ENABLED=false

# Standalone defaults to none for loopback-only prototyping.
# `development` accepts only the PUBLIC test token:
#   vt-data-local-development-token
# `bearer` requires MCP_BEARER_TOKENS; use this for deployment.
# The existing API mount requires bearer mode when MCP_ENABLED=true.
# MCP_AUTH_MODE=none

# Comma-separated tokens; every token grants the same read-only tools.
# Generate one per client with `just mcp-token`. Never deploy the public test
# token. Removing a token and restarting revokes it; overlap tokens to rotate.
# MCP_BEARER_TOKENS=

# Standalone bind defaults. none/development must remain on loopback.
# MCP_HOST=127.0.0.1
# MCP_PORT=6768

# Comma-separated HTTP Host allowlist (hostnames with optional ports), plus
# allowed Origin values when an Origin header is supplied. Localhost defaults
# work for local development. Set the public hostname explicitly in deployment.
# MCP_ALLOWED_HOSTS=data.example.org,localhost:*,127.0.0.1:*
# MCP_ALLOWED_ORIGINS=https://data.example.org

# Bounds on every service instance. HTTP rate limit is per client per minute;
# multiple worker processes each maintain their own counters.
# MCP_MAX_ROWS=1000
# MCP_MAX_BYTES=1000000
# MCP_QUERY_TIMEOUT=20
# MCP_MAX_CONCURRENCY=4
# MCP_RATE_LIMIT=120
# MCP_MAX_REQUEST_BYTES=65536
# Total seconds to receive the HTTP body, before tool execution (0.1–120).
# MCP_REQUEST_BODY_TIMEOUT=10
